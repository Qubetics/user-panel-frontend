# ---------------------------------------------------------------------------
# user-panel-frontend environment variables
# Copy this file to `.env` and replace the values below with your own.
# This is a Vite app: every variable must be prefixed with VITE_ to be exposed
# to the client.
#
# NOTE: the values below are ILLUSTRATIVE EXAMPLES. Chain values and endpoints
# MUST be set to your actual network.
# ---------------------------------------------------------------------------

# --- API / backend endpoints ---
VITE_API_URL=http://localhost:7000
VITE_APP_API_URL=http://localhost:7000
VITE_PROVIDER_URL=http://localhost:8000
VITE_SWAGGER_HTTP_HOST=https://evm-rpc.example.com
VITE_EXPLORER_API=https://explorer.qubetics.com/api
VITE_EXPLORER_ENDPOINT=https://explorer.qubetics.com

# --- Chain configuration (examples — set to your network's values) ---
VITE_CHAINID=qubetics_9030-1          # example EVM/Cosmos chain-id format
VITE_CURRENCY=TICS

# --- Related Qubetics apps / docs ---
VITE_QUBETICS_VALIDATOR_APP_LINK=https://validator.qubetics.com/
VITE_QUBETICS_DELEGATOR_APP_LINK=https://delegator.qubetics.com/
VITE_QUBETICS_DOCUMENTATION_LINK=https://qubetics.gitbook.io/qubetics-docs
VITE_NETWORK_DOCUMENTATION_LINK=https://docs.qubetics.com/
VITE_GITBOOK_LINK=https://qubetics.gitbook.io/qubetics-docs
VITE_QUBEQODE_LINK=https://qubeqode.qubetics.com
VITE_IDE_LINK=https://ide.qubetics.com

# --- App store / download links ---
VITE_APPSTORE_LINK=https://apps.apple.com/app/qubetics-dvpn
VITE_PLAYSTORE_LINK=https://play.google.com/store/apps/details?id=com.qubetics.dvpn

# --- Marketing / external links ---
VITE_WEB_LINK=https://www.qubetics.com/
VITE_COINMARKETCAP_LINK=https://coinmarketcap.com/currencies/qubetics/
VITE_PRIVACY_POLICY_LINK=https://www.qubetics.com/privacy-policy
VITE_TERMS_OF_SERVICE_LINK=https://www.qubetics.com/terms-of-use

# --- Social links ---
VITE_X_LINK=https://x.com/qubetics
VITE_TELEGRAM_LINK=https://t.me/qubetics
VITE_DISCORD_LINK=https://discord.com/invite/KHfSNbzdSE
